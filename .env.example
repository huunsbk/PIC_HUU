# Frontend-safe Supabase configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Never expose this as a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional local database connection for read-only audits/diagnostics.
# Keep real values in .env.db.local, not in commits.
SUPABASE_DB_URL=
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=false
