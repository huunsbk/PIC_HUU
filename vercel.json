{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/admin/accounts",
      "destination": "/api/admin/accounts/index"
    },
    {
      "source": "/api/admin/accounts/:id",
      "destination": "/api/admin/account-item?id=:id"
    },
    {
      "source": "/api/public/tournament/:slug",
      "destination": "/api/public/tournament-item?slug=:slug"
    },
    {
      "source": "/api/commercial/orders",
      "destination": "/api/commercial/orders/index"
    },
    {
      "source": "/api/commercial/orders/current",
      "destination": "/api/commercial/orders/index?action=current"
    },
    {
      "source": "/api/commercial/orders/manual-review",
      "destination": "/api/commercial/orders/index?action=manual-review"
    },
    {
      "source": "/api/admin/commercial/manual-reviews",
      "destination": "/api/admin/commercial-reviews?action=list"
    },
    {
      "source": "/api/admin/commercial/manual-reviews/confirm",
      "destination": "/api/admin/commercial-reviews?action=confirm"
    },
    {
      "source": "/api/admin/commercial/manual-reviews/reject",
      "destination": "/api/admin/commercial-reviews?action=reject"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
